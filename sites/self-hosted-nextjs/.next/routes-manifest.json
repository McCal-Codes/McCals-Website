{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/concerts",
      "regex": "^/concerts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/concerts(?:/)?$"
    },
    {
      "page": "/events",
      "regex": "^/events(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/events(?:/)?$"
    },
    {
      "page": "/featured-work",
      "regex": "^/featured\\-work(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/featured\\-work(?:/)?$"
    },
    {
      "page": "/journalism",
      "regex": "^/journalism(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/journalism(?:/)?$"
    },
    {
      "page": "/nature",
      "regex": "^/nature(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/nature(?:/)?$"
    },
    {
      "page": "/podcast",
      "regex": "^/podcast(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/podcast(?:/)?$"
    },
    {
      "page": "/portraits",
      "regex": "^/portraits(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portraits(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}