# Next.js environment variables
# Copy this to .env.local for local development

# API Base URL
NEXT_PUBLIC_API_URL=https://api.mcc-cal.com

# Optional: Custom CDN base for images
# NEXT_PUBLIC_CDN_BASE=https://cdn.jsdelivr.net/gh/McCal-Codes/mccal-api@manifests-cdn

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
