{
  "name": "mcc-cal-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-manifests.js",
    "dev": "vite",
    "dev:api": "concurrently \"node api-server.cjs\" \"vite\"",
    "predev:vercel": "node scripts/sync-manifests.js",
    "dev:vercel": "vercel dev",
    "validate:manifests": "node scripts/validate-manifests.js || echo 'Validation skipped'",
    "prebuild": "node scripts/sync-manifests.js || echo 'Sync skipped'",
    "build": "tsc -b && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern dist",
    "analyze": "set ANALYZE=true&& npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.27",
    "dompurify": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.2",
    "vitest": "^3.0.0"
  }
}
