# Vite environment variables (prefix with VITE_ to expose to browser)
VITE_SITE_URL=https://mcc-cal.com
VITE_NEWSLETTER_ENDPOINT=https://mcc-cal.us14.list-manage.com/subscribe/post?u=da029ed85760894c33e8b119d&id=fb992a38c8&f_id=00cf8ae0f0
VITE_API_URL=https://api.mcc-cal.com

# Google Calendar API (for scheduling/booking)
# Get from Google Cloud Console > Service Account > Keys
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary

# Email service (Resend)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=contact@mcc-cal.com
CONTACT_FROM_EMAIL=noreply@mcc-cal.com

# CORS origins for booking API (comma-separated)
BOOKING_ALLOWED_ORIGINS=https://mcc-cal.com,https://www.mcc-cal.com
