# Vite environment variables (prefix with VITE_ to expose to browser)
VITE_SITE_URL=https://mcc-cal.com
VITE_NEWSLETTER_ENDPOINT=https://mcc-cal.us14.list-manage.com/subscribe/post?u=da029ed85760894c33e8b119d&id=fb992a38c8&f_id=00cf8ae0f0
VITE_API_URL=https://api.mcc-cal.com

# Google Calendar API (for scheduling/booking)
# Get from Google Cloud Console > Service Account > Keys
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary

# Email service (Resend)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=contact@mcc-cal.com
CONTACT_FROM_EMAIL=noreply@mcc-cal.com

# CORS origins for public APIs (comma-separated)
# Applies to booking, availability, google-reviews, and manifest endpoints.
API_ALLOWED_ORIGINS=https://mcc-cal.com,https://www.mcc-cal.com

# Google Places API (for reviews)
# Get from Google Cloud Console > APIs & Services > Credentials
GOOGLE_PLACES_API_KEY=your-places-api-key-here
# Find your Place ID at: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=ChIJ...

# Supabase (PostgreSQL database)
# Get from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key - ONLY for server-side API routes (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sentry error/performance monitoring
# VITE_SENTRY_DSN is public-safe and enables browser monitoring in production builds.
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=mccal-media-74
SENTRY_PROJECT=mccal-vite
SENTRY_AUTH_TOKEN=
VITE_ENABLE_SENTRY_TEST_PAGE=false
VITE_SENTRY_ENABLE_LOGS=true
VITE_SENTRY_SEND_DEFAULT_PII=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
SENTRY_SERVER_TRACES_SAMPLE_RATE=0.1

# Google Analytics 4 (optional, in addition to Vercel Analytics)
# Get from Google Analytics > Admin > Data Streams > your stream > Measurement ID
VITE_GA_MEASUREMENT_ID=
VITE_ENABLE_GA=false
