{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/widgets/[...slug].js": {
      "includeFiles": "../../src/widgets/**",
      "excludeFiles": "../../src/widgets/_archived/**,../../src/widgets/_content/**,../../src/widgets/_cdn/**,../../src/widgets/_admin/**,../../src/widgets/_navigation/**"
    },
    "api/manifests/[type].js": {
      "includeFiles": "../../src/images/Portfolios/Concert/concert-manifest.json,../../src/images/Portfolios/Events/events-manifest.json,../../src/images/Portfolios/Journalism/journalism-manifest.json,../../src/images/Portfolios/Nature/nature-manifest.json,../../src/images/Portfolios/Portrait/portrait-manifest.json,../../src/images/Portfolios/portfolio-manifest.json"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
