{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/widgets/[...slug].js": {
      "includeFiles": "../../src/widgets/**"
    },
    "api/manifests/[type].js": {
      "includeFiles": "../../src/images/Portfolios/**/*.json"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
