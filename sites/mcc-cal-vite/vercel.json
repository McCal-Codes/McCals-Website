{
  "framework": "vite",
  "buildCommand": "npm ci && npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "cleanUrls": true,
  "images": {
    "sizes": [
      160,
      256,
      320,
      360,
      384,
      480,
      540,
      640,
      720,
      750,
      828,
      960,
      1080,
      1200,
      1280,
      1440,
      1600,
      1920,
      2048,
      3840
    ],
    "localPatterns": [
      {
        "pathname": "^/about/.*$",
        "search": ""
      },
      {
        "pathname": "^/assets/.*$",
        "search": ""
      },
      {
        "pathname": "^/content/blog-static/.*$",
        "search": ""
      },
      {
        "pathname": "^/images/.*$",
        "search": ""
      }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "images.squarespace-cdn.com",
        "port": "",
        "pathname": "^/.*$"
      },
      {
        "protocol": "https",
        "hostname": "cdn.jsdelivr.net",
        "port": "",
        "pathname": "^/gh/McCal-Codes/McCals-Website@main/src/images/Portfolios/.*$"
      },
      {
        "protocol": "https",
        "hostname": "images.mcc-cal.com",
        "port": "",
        "pathname": "^/.*$"
      }
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ]
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mcc-cal.com"
        }
      ],
      "destination": "https://mcc-cal.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mcc-cal.com"
        }
      ],
      "destination": "https://mcc-cal.com/:path*",
      "permanent": true
    },
    {
      "source": "/grab-coffee",
      "destination": "/grab-a-coffee",
      "permanent": true
    },
    {
      "source": "/schedule",
      "destination": "/grab-a-coffee",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/event",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/featured",
      "destination": "/featured-work",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/images/bfa-thesis/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/manifests/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://mcc-cal.us14.list-manage.com; img-src 'self' data: blob: https://mcc-cal.com https://www.mcc-cal.com https://images.mcc-cal.com https://images.squarespace-cdn.com https://cdn.jsdelivr.net https://media.rss.com https://img.youtube.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-TEuBCCZi5A9kHZ4G1q/zCx/dcYsVfM7iWGFQ0xHQ3fU=' 'sha256-ndPLrlpaq0NHjt0NtYwSz660fsrBpc3KKF50K3LHPUo=' https://vercel.live https://va.vercel-scripts.com https://www.googletagmanager.com; connect-src 'self' https://api.mcc-cal.com https://*.supabase.co https://vitals.vercel-insights.com https://media.rss.com https://vercel.live https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com; worker-src 'self' blob:; child-src 'self' blob:; media-src 'self' blob: https://content.rss.com https://media.rss.com; frame-src 'self' https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?mcc-cal\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/links",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
