{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/widgets/[...slug].js": {
      "includeFiles": "../../src/widgets/**",
      "excludeFiles": "../../src/widgets/_archived/**,../../src/widgets/_cdn/**,../../src/widgets/_admin/**,../../src/widgets/_navigation/**"
    },
    "api/manifests/[type].js": {
      "includeFiles": "api/manifests/data/*.json"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "mcc-cal\\.com" }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
