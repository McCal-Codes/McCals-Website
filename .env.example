# McCal Media Website & API - Environment Configuration
# Copy this file to .env and update with your values
#
# Required for local widget/demo use: PORT, MANIFEST_BASE_URL, MANIFEST_TYPES.
# Everything else is optional unless you are running the API/Cloudflare worker or blog flows.

# ==============================================================================
# NODE ENVIRONMENT
# ==============================================================================
NODE_ENV=development  # Options: development, staging, production

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Port for local development server (website)
PORT=3000

# API Server Port
API_PORT=3001

# ==============================================================================
# API MANIFEST CONFIGURATION
# ==============================================================================
# Base URL where portfolio manifests are hosted (GitHub Pages, CDN, etc.)
MANIFEST_BASE_URL=https://McCal-Codes.github.io/McCals-Website/src/images/Portfolios

# Comma-separated list of manifest types to load
# Valid types: concert, events, journalism, nature, portrait, portfolio (universal)
MANIFEST_TYPES=concert,events,journalism,nature,portrait,portfolio

# ==============================================================================
# BLOG CONFIGURATION
# ==============================================================================
# Base URL for blog posts and related assets
BLOG_BASE_URL=https://McCal-Codes.github.io/McCals-Website/src/images/blog

# JWT Secret for blog authoring authentication
# IMPORTANT: Change this in production! Use a strong random string.
BLOG_JWT_SECRET=dev-jwt-secret-change-in-production

# Blog Authors - JSON array of author credentials for authentication
# Format: [{"id":"author1","username":"user","password":"pass","name":"Display Name"}]
# IMPORTANT: Change credentials in production! Use strong passwords.
BLOG_AUTHORS=[{"id":"mccal","username":"mccal","password":"changeme","name":"McCal"}]

# ==============================================================================
# WEBHOOK CONFIGURATION
# ==============================================================================
# Secret for GitHub Actions webhook authentication (cache invalidation)
# IMPORTANT: Change this in production! Use a strong random string.
WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# Optional: Manifest webhook proxy (e.g., Cloudflare Worker) that forwards to API and falls back to GitHub/CDN
# If set, manifest generators/watchers will POST to: ${MANIFEST_WEBHOOK_BASE}/refresh/{type}
MANIFEST_WEBHOOK_BASE=https://your-worker.example.com/api/v1/webhooks
# Alternative single-URL form (supports {type} placeholder). If both are set, MANIFEST_WEBHOOK_URL wins.
MANIFEST_WEBHOOK_URL=

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed origins for CORS
# Supports wildcard subdomains: *.squarespace.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://mcc-cal.com,https://*.squarespace.com,https://api.mcc-cal.com

# ==============================================================================
# CACHE CONFIGURATION
# ==============================================================================
# Redis connection URL (optional - leave empty to use in-memory cache)
# Format: redis://[username]:[password]@[host]:[port]/[database]
# Example: redis://localhost:6379/0
REDIS_URL=

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# ==============================================================================
# CLOUDFLARE CONFIGURATION (for production API)
# ==============================================================================
# Cloudflare Workers KV namespace ID (optional - for production API deployment)
# Get from: Cloudflare Dashboard → Workers → KV
KV_NAMESPACE_ID=

# Cloudflare API Token (optional - for production API deployment)
# Permissions needed: Workers KV Storage:Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID (optional - for production API deployment)
CLOUDFLARE_ACCOUNT_ID=

# ==============================================================================
# MONITORING & DEBUGGING
# ==============================================================================
# Enable debug logging
DEBUG=false

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable performance metrics
ENABLE_METRICS=false

# ==============================================================================
# EXTERNAL SERVICES (Optional)
# ==============================================================================
# Google Analytics Tracking ID (optional)
GA_TRACKING_ID=

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Mailchimp API Key for newsletter signup (optional)
MAILCHIMP_API_KEY=

# Mailchimp List ID (optional)
MAILCHIMP_LIST_ID=

# ==============================================================================
# SQUARESPACE INTEGRATION (Optional)
# ==============================================================================
# Squarespace API Key (if using Squarespace API)
SQUARESPACE_API_KEY=

# Squarespace Site ID
SQUARESPACE_SITE_ID=

# ==============================================================================
# CDN & ASSET HOSTING (Optional)
# ==============================================================================
# CDN base URL for static assets
CDN_BASE_URL=https://cdn.jsdelivr.net/gh/McCal-Codes/McCals-Website@main

# S3 bucket for image uploads (optional)
S3_BUCKET=

# S3 region
S3_REGION=us-east-1

# AWS Access Key (optional)
AWS_ACCESS_KEY_ID=

# AWS Secret Key (optional)
AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# DATABASE (Optional - for future extensions)
# ==============================================================================
# PostgreSQL connection URL (optional - for future blog/CMS features)
DATABASE_URL=

# ==============================================================================
# SECURITY
# ==============================================================================
# Rate limiting: max requests per window
RATE_LIMIT_MAX=100

# Rate limiting: time window in milliseconds
RATE_LIMIT_WINDOW=60000

# Enable HTTPS redirect (set to true in production)
FORCE_HTTPS=false

# Session secret for authentication (if implementing admin features)
SESSION_SECRET=dev-session-secret-change-in-production

# ==============================================================================
# DEVELOPMENT TOOLS
# ==============================================================================
# Enable hot reload in development
HOT_RELOAD=true

# Enable source maps in production
SOURCE_MAPS=false

# Enable webpack bundle analyzer
ANALYZE_BUNDLE=false
