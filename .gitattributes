# Mark image and binary asset types as binary so Git handles them correctly
# Consider enabling Git LFS for very large files (>5-10MB). This file does not enable LFS itself.
src/images/** binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.mp4 binary
*.mov binary
*.heic binary

# Do not include build artifacts in exported archives
/dist/ export-ignore
/node_modules/ export-ignore

# Optional: avoid including large logs in archives
/logs/* export-ignore

# End of .gitattributes — generated by automated repo housekeeping
