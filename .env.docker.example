# Docker Compose Environment Variables
# Copy this file to .env in the same directory as docker-compose.yml
# Generate secure secrets using the commands provided

# ==============================================================================
# REQUIRED: WEBHOOK SECRET
# ==============================================================================
# Secret for webhook authentication (cache invalidation)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ==============================================================================
# OPTIONAL: Override default ports
# ==============================================================================
# Uncomment to change default ports
# API_PORT=3001
# REDIS_PORT=6379
# REDISINSIGHT_PORT=8001

# ==============================================================================
# OPTIONAL: Additional configuration
# ==============================================================================
# NODE_ENV=production
# CACHE_TTL_MINUTES=60

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# 1. Never commit this file to version control
# 2. Generate strong random secrets for production
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Keep this file permissions restricted: chmod 600 .env
