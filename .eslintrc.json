{
  "root": true,
  "env": {
    "node": true,
    "browser": true,
    "es2020": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "no-useless-escape": "off",
    "no-constant-condition": ["warn"]
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "logs/**", "coverage/**", "scripts/_archived/**"]
}
