{
  "name": "mccal-media-website",
  "version": "2.5.3",
  "description": "McCal Media photo gallery website with development tools",
  "main": "src/site/index.html",
  "scripts": {
    "ai:preflight": "node scripts/utils/ai-instructions-preflight.js",
    "ai:preflight:short": "node scripts/utils/ai-instructions-preflight.js --short",
    "ai:preflight:json": "node scripts/utils/ai-instructions-preflight.js --json",
    "ai:finalize": "node scripts/utils/ai-finalize-session.js --summary",
    "api:start": "node src/api/server.js",
    "api:dev": "nodemon src/api/server.js",
    "api:test": "curl http://localhost:3001/api/health",
    "api:refresh": "curl -X POST http://localhost:3001/api/v1/webhooks/invalidate-all",
    "api:refresh:concert": "curl -X POST http://localhost:3001/api/v1/webhooks/refresh/concert",
    "api:refresh:events": "curl -X POST http://localhost:3001/api/v1/webhooks/refresh/events",
    "api:refresh:journalism": "curl -X POST http://localhost:3001/api/v1/webhooks/refresh/journalism",
    "api:demo-seo": "npm run api:start & sleep 5 && npm run seo:all && echo '\n✅ Demo complete! Check dist/sitemap.xml and dist/structured-data/'",
    "dev": "node dev-server.js",
    "serve:site": "SERVE_TARGET=site node dev-server.js",
    "site:export": "(cd sites/self-hosted-nextjs && npm install --no-audit --no-fund && npm run build && npm run export)",
    "dev:with-api": "concurrently -n \"SITE,API\" -c \"cyan,green\" \"node dev-server.js --with-api\" \"nodemon src/api/server.js\"",
    "dev:full": "concurrently -n \"SITE,API,WATCH\" -c \"cyan,green,yellow\" \"node dev-server.js --with-api\" \"nodemon src/api/server.js\" \"node scripts/watchers/watch-auto-manifest.js --all\"",
    "ci:simulate": "node scripts/utils/ci-simulate-changed.js",
    "ci:simulate:sample1": "node scripts/utils/ci-simulate-changed.js --changed 'scripts/utils/build.js docs/README.md'",
    "ci:simulate:sample2": "node scripts/utils/ci-simulate-changed.js --changed '.github/copilot-instructions.md src/site/app.js'",
    "admin:backend": "node scripts/admin/admin-import-backend.js",
    "build": "node scripts/utils/build.js",
    "organize:concerts": "node scripts/watchers/auto-concert-organizer.js --auto",
    "organize:preview": "node scripts/watchers/auto-concert-organizer.js --auto --dry",
    "organize:folders": "node scripts/watchers/auto-concert-folder-organizer.js",
    "organize:folders-preview": "node scripts/watchers/auto-concert-folder-organizer.js --dry-run",
    "deploy:placeholder": "echo 'Deployment scripts archived. Use documented manual deployment workflow.'",
    "package": "npm pack",
    "docker:build": "docker build -t mccal-media-website .",
    "docker:run": "docker run -p 8080:8080 mccal-media-website",
    "docker:deploy": "docker build -t mccal-media-website . && docker run -d -p 8080:8080 --name mccal-website mccal-media-website",
    "manifest:generate": "node scripts/manifest/enhanced-manifest-generator.js --auto",
    "blog:generate": "node scripts/blog/generate-blog-feed.js",
    "manifest:dry-run": "node scripts/manifest/enhanced-manifest-generator.js --auto --dry --verbose",
    "manifest:single": "node scripts/manifest/enhanced-manifest-generator.js",
    "manifest:journalism": "node scripts/manifest/generate-journalism-manifest-v2.js",
    "manifest:events": "node scripts/manifest/generate-events-manifest.js --root src/images/Portfolios/Events --force",
    "manifest:nature": "node scripts/manifest/generate-nature-manifest.js",
    "manifest:portrait": "node scripts/manifest/generate-portrait-manifest.js",
    "watch:journalism-manifest": "node scripts/watchers/watch-journalism-manifest.js",
    "watch:events-manifest": "node scripts/watchers/watch-events-manifest.js",
    "manifest:concert": "node scripts/manifest/generate-concert-manifest.js",
    "build:concert": "npm run organize:folders && npm run manifest:concert",
    "watch:concert": "node scripts/watchers/watch-concert-folders.js",
    "manifest:universal": "node scripts/manifest/generate-universal-manifest.js",
    "manifest:fallback": "node scripts/manifest/generate-fallback-manifests.js",
    "build:universal": "npm run organize:folders && npm run manifest:concert && npm run manifest:universal",
    "watch:universal": "node scripts/watchers/watch-universal-portfolios.js",
    "build:optimized": "npm run build:universal",
    "watch:auto-manifest": "node scripts/watchers/watch-auto-manifest.js",
    "watch:auto-manifest:concert": "node scripts/watchers/watch-auto-manifest.js --target concert",
    "watch:auto-manifest:events": "node scripts/watchers/watch-auto-manifest.js --target events",
    "watch:auto-manifest:journalism": "node scripts/watchers/watch-auto-manifest.js --target journalism",
    "watch:auto-manifest:nature": "node scripts/watchers/watch-auto-manifest.js --target nature",
    "watch:auto-manifest:portrait": "node scripts/watchers/watch-auto-manifest.js --target portrait",
    "watch:auto-manifest:all": "node scripts/watchers/watch-auto-manifest.js --all",
    "dev:auto": "npm run watch:auto-manifest",
    "manifest:featured": "node scripts/manifest/generate-featured-manifest.js",
    "watch:nature-manifest": "node scripts/watchers/watch-nature-manifest.js",
    "clean": "rm -rf dist logs/*.log site-workspace/temp site-workspace/drafts 2>/dev/null || true",
    "analyze:large-files": "find . -type f -size +1M -exec ls -lh {} \\; | awk '{print $5, $9}' | sort -hr",
    "repo:health": "npm run clean && npm run ai:preflight:short && npm run analyze:large-files",
    "analyze:duplicates": "find . -type f -exec stat -f '%z %N' {} \\; | sort | uniq -d | sort -nr",
    "validate:widgets": "node scripts/utils/validate-widget-html.js",
    "audit:dark-mode": "node scripts/utils/audit-dark-mode.js",
    "audit:widget-readmes": "node scripts/utils/widget-readme-audit.js",
    "optimize:events": "node scripts/utils/auto-optimize-events-images.js",
    "optimize:events:webp": "node scripts/utils/auto-optimize-events-images.js --webp",
    "ci:validate-scripts": "node scripts/utils/ci-validate-scripts.js",
    "ci:find-duplicates": "node scripts/utils/find-duplicate-scripts.js",
    "ci:archive-duplicates": "node scripts/utils/find-duplicate-scripts.js --archive",
    "ci:smoke-test": "node scripts/utils/smoke-test.js",
    "welcome": "node scripts/admin/welcome.js",
    "welcome:open": "code updates/welcome.md || open updates/welcome.md",
    "setup": "node scripts/admin/setup-repo.js",
    "postinstall": "npm run welcome",
    "lint:scripts": "npx eslint 'scripts/**/*.js' --max-warnings=50",
    "lint": "npx eslint 'scripts/**/*.js' 'src/site/**/*.js' --max-warnings=50",
    "test": "npx playwright test tests/playwright --reporter=list",
    "build:thesis": "node scripts/thesis/build-thesis-interactive.js",
    "dev:thesis": "node scripts/thesis/build-thesis-interactive.js --watch",
    "site-widgets:build": "node scripts/utils/build-site-widgets.js",
    "site-widgets:prepare-release": "npm run site-widgets:build && echo 'Built site-widgets artifacts in dist/site-widgets'",
    "seo:sitemap": "node scripts/seo/generate-sitemap.js",
    "seo:schema": "node scripts/seo/generate-structured-data.js",
    "seo:all": "npm run seo:sitemap && npm run seo:schema",
    "prebuild": "npm run manifest:generate",
    "versions:standardize": "node scripts/utils/standardize-versions.js",
    "versions:check": "node scripts/utils/standardize-versions.js --dry-run --verbose",
    "versions:rename": "node scripts/utils/rename-widget-versions.js",
    "versions:rename-check": "node scripts/utils/rename-widget-versions.js --dry-run --verbose",
    "scan:widget-versions": "node scripts/utils/scan-widget-versions.js"
  },
  "keywords": [
    "photography",
    "gallery",
    "portfolio",
    "website"
  ],
  "author": "McCal Media",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.23.0",
    "eslint": "^8.46.0",
    "http-server": "^14.1.1",
    "lighthouse": "^13.0.1",
    "nodemon": "^3.1.11",
    "open": "^10.1.0",
    "playwright": "^1.39.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "etag": "^1.8.1",
    "exif-parser": "^0.1.12",
    "express": "^5.1.0",
    "lottie-web": "^5.13.0",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^5.10.0"
  }
}
