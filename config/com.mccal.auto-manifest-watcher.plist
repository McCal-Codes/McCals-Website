<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mccal.auto-manifest-watcher</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>scripts/watch-auto-manifest.js</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/mccal/McCals-Website</string>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/Users/mccal/McCals-Website/logs/auto-manifest-stdout.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/mccal/McCals-Website/logs/auto-manifest-stderr.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>
    
    <!-- Optional: Only run when on AC power -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <!-- Restart if crashed -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>