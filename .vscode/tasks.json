{
  // AI preflight, helper, and onboarding tasks
  "version": "2.0.0",
  "tasks": [
    // Welcome/onboarding
    {
      "label": "Welcome: Show Welcome Message",
      "type": "shell",
      "command": "npm",
      "args": ["run", "welcome"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Open Bookmarks Hub",
      "type": "shell",
      "command": "npm",
      "args": ["run", "bookmarks:open"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docs: Open Onboarding",
      "type": "shell",
      "command": "npm",
      "args": ["run", "onboarding:open"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Updates: Open TODO List",
      "type": "shell",
      "command": "npm",
      "args": ["run", "todo:open"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    // AI preflight tasks
    {
      "label": "AI: Preflight (short)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js", "--short"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "AI: Preflight (full)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "AI: Preflight (json)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js", "--json"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    // AI finalize
    {
      "label": "AI: Finalize (prompt)",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/utils/ai-finalize-session.js",
        "--summary",
        "${input:aiSummary}",
        "--bump",
        "${input:aiBump}"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Manifest: Generate All",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:generate"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Concert Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:concert"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Events Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:events"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Journalism Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:journalism"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Server: Start",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:auto"],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Vercel: Dev Server (mcc-cal-vite)",
      "type": "shell",
      "command": "npx",
      "args": ["--yes", "vercel", "dev", "--listen", "3000", "--yes"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "vercel"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".+"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "Available at http://localhost:3000/?"
        }
      }
    },
    {
      "label": "Vite: Dev Server (mcc-cal-vite)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"],
      "options": {
        "cwd": "${workspaceFolder}/sites/mcc-cal-vite"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "vite"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".+"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "http://127.0.0.1:5173/?"
        }
      }
    },
    {
      "label": "Build: Universal Portfolio",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:universal"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Repository: Health Check",
      "type": "shell",
      "command": "npm",
      "args": ["run", "repo:health"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Analyze: Large Files",
      "type": "shell",
      "command": "npm",
      "args": ["run", "analyze:large-files"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Analyze: Duplicates",
      "type": "shell",
      "command": "npm",
      "args": ["run", "analyze:duplicates"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Organize: Concert Folders",
      "type": "shell",
      "command": "npm",
      "args": ["run", "organize:folders"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Watch: Auto Manifest",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch:auto-manifest"],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Git: Status",
      "type": "shell",
      "command": "git",
      "args": ["status", "--short"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Git: Quick Commit",
      "type": "shell",
      "command": "git",
      "args": ["add", ".", "&&", "git", "commit", "-m", "${input:commitMessage}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Security: Audit",
      "type": "shell",
      "command": "npm",
      "args": ["audit"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Update",
      "type": "shell",
      "command": "npm",
      "args": ["update"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Dry Run",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:dry-run"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Featured",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:featured"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Concert Portfolio",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:concert"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Optimized",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:optimized"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Organize: Preview",
      "type": "shell",
      "command": "npm",
      "args": ["run", "organize:preview"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Admin: Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "admin:backend"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "CI: Simulate Sample 1",
      "type": "shell",
      "command": "npm",
      "args": ["run", "ci:simulate:sample1"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "CI: Simulate Sample 2",
      "type": "shell",
      "command": "npm",
      "args": ["run", "ci:simulate:sample2"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "docker:build"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Package: Create",
      "type": "shell",
      "command": "npm",
      "args": ["run", "package"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean & Rebuild",
      "type": "shell",
      "command": "npm",
      "args": ["run", "clean", "&&", "npm", "run", "build:universal"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Widget: Validate HTML",
      "type": "shell",
      "command": "npm",
      "args": ["run", "validate:widgets"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Backup: Repository",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "timestamp=$(date +%Y-%m-%d_%H-%M-%S); backup_path=\"backup_$timestamp.zip\"; zip -r \"$backup_path\" . -x 'node_modules/*' '.git/*' 'dist/*' 'logs/*'; echo \"Backup created: $backup_path\""
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    // Dev Site Tasks
    {
      "label": "Dev Site: Next.js Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/sites/dev.mcc-cal.com"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devSite"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting...",
          "endsPattern": "Ready in"
        }
      }
    },
    {
      "label": "Dev Site: Cloudflare Tunnel",
      "type": "shell",
      "command": "cloudflared",
      "args": ["tunnel", "run", "mccal-dev"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devSite"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting tunnel",
          "endsPattern": "Registered tunnel connection"
        }
      }
    },
    {
      "label": "Manifest: Generate Selected",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:${input:manifestType}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Selected Type",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:${input:buildType}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "aiSummary",
      "type": "promptString",
      "description": "Brief summary to append to instructions and changelog",
      "default": "Session complete: minor updates."
    },
    {
      "id": "aiBump",
      "type": "pickString",
      "description": "Optional version bump (package.json)",
      "options": ["none", "patch", "minor", "major"],
      "default": "none"
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message for quick commit",
      "default": "Minor updates and improvements"
    },
    {
      "id": "manifestType",
      "type": "pickString",
      "description": "Type of manifest to generate",
      "options": ["all", "concert", "events", "journalism", "universal", "featured"],
      "default": "all"
    },
    {
      "id": "buildType",
      "type": "pickString",
      "description": "Type of build to perform",
      "options": ["universal", "concert", "optimized"],
      "default": "universal"
    }
  ],
  "compounds": [
    {
      "label": "Dev Site: Start All",
      "dependsOn": ["Dev Site: Next.js Server", "Dev Site: Cloudflare Tunnel"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
