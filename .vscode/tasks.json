{
  // AI preflight and helper tasks
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI: Preflight (short)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js", "--short"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "AI: Preflight (full)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "AI: Preflight (json)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js", "--json"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
    ,
    {
      "label": "AI: Finalize (prompt)",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/utils/ai-finalize-session.js",
        "--summary",
        "${input:aiSummary}",
        "--bump",
        "${input:aiBump}"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Manifest: Generate All",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:generate"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Concert Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:concert"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Events Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:events"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Journalism Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:journalism"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev Server: Start",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:auto"],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Universal Portfolio",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:universal"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Repository: Health Check",
      "type": "shell",
      "command": "npm",
      "args": ["run", "repo:health"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Analyze: Large Files",
      "type": "shell",
      "command": "npm",
      "args": ["run", "analyze:large-files"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Analyze: Duplicates",
      "type": "shell",
      "command": "npm",
      "args": ["run", "analyze:duplicates"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Organize: Concert Folders",
      "type": "shell",
      "command": "npm",
      "args": ["run", "organize:folders"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Watch: Auto Manifest",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch:auto-manifest"],
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Git: Status",
      "type": "shell",
      "command": "git",
      "args": ["status", "--short"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Git: Quick Commit",
      "type": "shell",
      "command": "git",
      "args": ["add", ".", "&&", "git", "commit", "-m", "${input:commitMessage}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "aiSummary",
      "type": "promptString",
      "description": "Brief summary to append to instructions and changelog",
      "default": "Session complete: minor updates."
    },
    {
      "id": "aiBump",
      "type": "pickString",
      "description": "Optional version bump (package.json)",
      "options": ["none", "patch", "minor", "major"],
      "default": "none"
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message for quick commit",
      "default": "Minor updates and improvements"
    }
  ]
}