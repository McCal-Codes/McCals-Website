{
  // AI preflight and helper tasks
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI: Preflight (short)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js", "--short"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "AI: Preflight (full)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "AI: Preflight (json)",
      "type": "shell",
      "command": "node",
      "args": ["scripts/utils/ai-instructions-preflight.js", "--json"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
    ,
    {
      "label": "AI: Finalize (prompt)",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/utils/ai-finalize-session.js",
        "--summary",
        "${input:aiSummary}",
        "--bump",
        "${input:aiBump}"
      ],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Manifest: Generate All",
      "type": "shell",
