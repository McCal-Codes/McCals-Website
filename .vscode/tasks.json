    {
      "label": "Package: Create",
      "type": "shell",
      "command": "npm",
      "args": ["run", "package"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean & Rebuild",
      "type": "shell",
      "command": "npm",
      "args": ["run", "clean", "&&", "npm", "run", "build:universal"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Widget: Validate HTML",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Get-ChildItem -Path 'src/widgets' -Filter '*.html' -Recurse | ForEach-Object { Write-Host \"Validating: $($_.FullName)\"; $content = Get-Content $_.FullName -Raw; if ($content -match '<!DOCTYPE html>|<html') { Write-Host \"✅ Valid HTML structure\" } else { Write-Host \"❌ Missing HTML structure\" } }"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Backup: Repository",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "$timestamp = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'; $backupPath = \"backup_$timestamp.zip\"; Compress-Archive -Path . -DestinationPath $backupPath -Force; Write-Host \"Backup created: $backupPath\""
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Manifest: Generate Selected",
      "type": "shell",
      "command": "npm",
      "args": ["run", "manifest:${input:manifestType}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: Selected Type",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:${input:buildType}"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "aiSummary",
      "type": "promptString",
      "description": "Brief summary to append to instructions and changelog",
      "default": "Session complete: minor updates."
    },
    {
      "id": "aiBump",
      "type": "pickString",
      "description": "Optional version bump (package.json)",
      "options": ["none", "patch", "minor", "major"],
      "default": "none"
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message for quick commit",
      "default": "Minor updates and improvements"
    },
    {
      "id": "manifestType",
      "type": "pickString",
      "description": "Type of manifest to generate",
      "options": ["all", "concert", "events", "journalism", "universal", "featured"],
      "default": "all"
    },
    {
      "id": "buildType",
      "type": "pickString",
      "description": "Type of build to perform",
      "options": ["universal", "concert", "optimized"],
      "default": "universal"
    }
  ]
}