  <script>
  // Optimized theme toggle: cache elements, avoid unnecessary writes, respect system changes when no explicit user preference
  (function(){
    const THEME_KEY = 'mcc-theme';
    const prefers = window.matchMedia?.('(prefers-color-scheme: dark)');

    function currentSystemIsDark(){ return prefers ? prefers.matches : false; }

    function applyTheme(theme){
      if (theme) document.documentElement.setAttribute('data-theme', theme);
      else document.documentElement.removeAttribute('data-theme');

      const isDark = theme ? theme === 'dark' : currentSystemIsDark();
      if (cached.toggle){
        cached.toggle.setAttribute('aria-pressed', String(isDark));
      }
      if (cached.icon){
        // show sun when dark (toggle shows opposite action)
        cached.icon.textContent = isDark ? '☀️' : '🌙';
      }
    }

    function savePreference(theme){
      if (theme === null){
        localStorage.removeItem(THEME_KEY);
        return;
      }
      const prev = localStorage.getItem(THEME_KEY);
      if (prev === theme) return; // avoid unnecessary writes
      localStorage.setItem(THEME_KEY, theme);
    }

    function getSavedPreference(){
      const s = localStorage.getItem(THEME_KEY);
      return (s === 'dark' || s === 'light') ? s : null;
    }

    // Cached DOM refs
    const cached = { toggle: null, icon: null };

    function initTheme(){
      // URL param overrides (helpful for CI/visual tests)
      try{
        const urlTheme = new URLSearchParams(location.search).get('theme');
        if (urlTheme === 'dark' || urlTheme === 'light'){
          savePreference(urlTheme);
          applyTheme(urlTheme);
          return;
        }
      }catch(e){}

      const saved = getSavedPreference();
      if (saved) applyTheme(saved);
      else applyTheme(null); // uses system
    }

    // React to system changes only when user hasn't set a preference
    function systemChangeHandler(){
      if (!getSavedPreference()) applyTheme(null);
    }

    document.addEventListener('DOMContentLoaded', ()=>{
      cached.toggle = document.getElementById('mccThemeToggle');
      cached.icon = document.getElementById('mccThemeIcon');

      initTheme();

      cached.toggle?.addEventListener('click', ()=>{
        const explicit = getSavedPreference();
        const current = explicit || (document.documentElement.getAttribute('data-theme') || (currentSystemIsDark() ? 'dark' : 'light'));
        const next = current === 'dark' ? 'light' : 'dark';
        savePreference(next);
        applyTheme(next);
      });

      // listen for system changes and update when no explicit preference
      try{ prefers?.addEventListener?.('change', systemChangeHandler); }catch(e){ /* old browsers */ }
    });
  })();
  </script>

