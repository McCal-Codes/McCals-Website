<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>CSS Playground Widget v1.3 — Static Production Parts</title>
  <style>
  /* Theme variables (neutral light/dark) — no accent colors (black/white shades only) */
  :root{
    --bg: #ffffff;
    --surface: #ffffff;
    --elev-1: #f3f4f6;
    --text: #0b1220;
    --muted: #6b7280;
    --glass: rgba(255,255,255,0.6);
    --focus: rgba(17,24,39,0.12);
  }
  :root[data-theme="dark"]{
    --bg: #07101a;
    --surface: rgba(6,8,15,0.88);
    --elev-1: rgba(255,255,255,0.02);
    --text: #e6eef8;
    --muted: #94a3b8;
    --glass: rgba(255,255,255,0.04);
    --focus: rgba(255,255,255,0.06);
  }
  /* Respect system preference unless user explicitly set theme */
  @media(prefers-color-scheme:dark){ :root:not([data-theme]){ --bg:#07101a; --text:#e6eef8 } }
  html,body{height:100%;margin:0}
  body{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);padding:120px 24px 48px}
  main{max-width:1200px;margin:0 auto}
  h1{font-size:2.25rem;margin:0 0 8px}
  .header-row{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .playground-card{background:var(--surface);border-radius:16px;padding:28px;margin-bottom:28px;box-shadow:0 12px 32px rgba(15,23,42,0.06);border:1px solid rgba(15,23,42,0.04)}
  /* small wrapper only — production CSS below will style nav fully */
  .playground-nav-demo{padding:12px;margin-bottom:24px}
  /* Reuse production nav CSS (critical extract) */
  .playground-nav-demo .mcc-nav-widget{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;--mcc-nav-bg:var(--surface);--mcc-nav-border:rgba(0,0,0,0.06);--mcc-nav-text-primary:var(--text);--mcc-nav-text-secondary:var(--muted);--mcc-nav-text-muted:var(--muted);--mcc-nav-hover:var(--text);--mcc-nav-active:var(--text);--mcc-nav-button-bg:var(--text);--mcc-nav-button-text:var(--surface);--mcc-nav-mobile-bg:var(--surface);--mcc-nav-mobile-border:var(--elev-1)}
  @media(prefers-color-scheme:dark){.playground-nav-demo .mcc-nav-widget{--mcc-nav-bg:var(--surface);--mcc-nav-border:rgba(255,255,255,0.06);--mcc-nav-text-primary:var(--text);--mcc-nav-text-secondary:var(--muted);--mcc-nav-text-muted:var(--muted);--mcc-nav-hover:var(--text);--mcc-nav-active:var(--text);--mcc-nav-button-bg:var(--text);--mcc-nav-button-text:var(--surface);--mcc-nav-mobile-bg:var(--surface);--mcc-nav-mobile-border:var(--elev-1)}}
  .playground-nav-demo .mcc-nav{position:relative;background:var(--mcc-nav-bg);backdrop-filter:blur(12px) saturate(140%);border-bottom:1px solid var(--mcc-nav-border);}
  .playground-nav-demo .mcc-nav__inner{max-width:1140px;margin:0 auto;padding:12px 16px;display:flex;align-items:center;justify-content:space-between}
  .playground-nav-demo .mcc-nav__logo{font-weight:700;font-size:1.25rem;color:var(--mcc-nav-text-primary);text-decoration:none}
  .playground-nav-demo .mcc-nav__menu{display:flex;gap:18px;list-style:none;margin:0;padding:0}
  .playground-nav-demo .mcc-nav__menu a{color:var(--mcc-nav-text-primary);text-decoration:none;font-weight:500;padding:.4rem 0}
  .playground-nav-demo .mcc-nav__cta{background:var(--mcc-nav-button-bg);color:var(--mcc-nav-button-text);padding:.6rem 1rem;border-radius:.375rem;text-decoration:none}

  /* Buttons + forms (production extract) */
  .button-row{display:flex;gap:12px;flex-wrap:wrap}
  .spotify-support-btn{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:10px 16px;font-weight:600;background:var(--text);color:var(--surface);border:1px solid rgba(0,0,0,0.06)}
  :root[data-theme="dark"] .spotify-support-btn{background:var(--surface);color:var(--text);border:1px solid rgba(255,255,255,0.06)}
  .download-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:10px;background:var(--text);color:var(--surface);text-decoration:none;font-weight:600}

  /* Portfolio cards (production-like) */
  .portfolio-test-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
  .portfolio-card{background:var(--surface);border-radius:16px;overflow:hidden;box-shadow:0 18px 36px rgba(15,23,42,0.12)}
  .portfolio-card img{width:100%;height:220px;object-fit:cover;display:block}
  .portfolio-card-info{padding:18px}

  /* Footer extract */
  .footer-test{
    border-radius:18px;
    background:var(--surface);
    color:var(--text);
    padding:24px;
    border:1px solid var(--elev-1);
  }
  .footer-content{display:grid;grid-template-columns:2fr 1fr 1fr;gap:20px}
  .footer-bottom{margin-top:12px;font-size:0.85rem;color:var(--muted)}

  /* Podcast / Episode card neutral styling */
  .episode-card{background:var(--surface);color:var(--text);padding:22px;border-radius:16px;border:1px solid var(--elev-1);box-shadow:0 8px 20px rgba(2,6,23,0.06)}
  .episode-card .audio-player{background:transparent;color:inherit}
  .play-button{width:48px;height:48px;border-radius:999px;border:none;background:var(--text);color:var(--surface);display:inline-flex;align-items:center;justify-content:center;font-weight:700;cursor:pointer}
  :root[data-theme="dark"] .play-button{background:var(--surface);color:var(--text);border:1px solid rgba(255,255,255,0.04)}

  /* Accessible focus outlines */
  :is(a,button,input[type="range"],[tabindex]){outline: none}
  :is(a,button,input[type="range"],[tabindex]):focus-visible{box-shadow:0 0 0 3px var(--focus);border-radius:6px}
  
  /* Responsive */
  @media(max-width:900px){.footer-content{grid-template-columns:1fr 1fr}.portfolio-card img{height:180px}}
  @media(max-width:640px){body{padding:88px 12px 28px}.playground-nav-demo .mcc-nav__inner{padding:12px}.portfolio-card img{height:160px}}
  </style>
