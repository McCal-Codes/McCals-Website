    "PortfolioCard": {
      "name": "PortfolioCard",
      "entityType": "ReactComponent",
      "observations": [
        "Displays single portfolio group as clickable card",
        "Located in src/components/portfolio/PortfolioCard.tsx",
        "Props: group (PortfolioGroup), onOpen, onCopyLink",
        "Features: lazy-loaded cover image, photo count badge, published indicator",
        "Accessibility: keyboard navigable (Enter/Space), ARIA labels",
        "Animation: IntersectionObserver for staggered entrance",
        "Uses pf-card CSS class prefix"
      ]
    },
    "PortfolioGrid": {
      "name": "PortfolioGrid",
      "entityType": "ReactComponent",
      "observations": [
        "Main portfolio display component with grid layout",
        "Located in src/components/portfolio/PortfolioGrid.tsx",
        "Props: groups (PortfolioGroup[]), initialCount, batchSize",
        "Features: lazy load more, lightbox integration, copy link toast",
        "Lazy loads PortfolioLightbox via React.lazy()",
        "Manages visible item count state",
        "Uses pf-grid CSS class"
      ]
    },
    "PortfolioLightbox": {
      "name": "PortfolioLightbox",
      "entityType": "ReactComponent",
      "observations": [
        "Full-screen image viewer for portfolio groups",
        "Located in src/components/portfolio/PortfolioLightbox.tsx",
        "Props: group (PortfolioGroup | null), onClose",
        "Features: keyboard navigation (Escape, arrows), scroll gallery",
        "Accessibility: role=dialog, aria-label, focus trap",
        "Lazy loads images conditionally (first 2 eager, rest lazy)",
        "Uses pf-lightbox CSS class prefix"
      ]
    },
    "PortfolioFilters": {
      "name": "PortfolioFilters",
      "entityType": "ReactComponent",
      "observations": [
        "Filter buttons for portfolio categories/years",
        "Located in src/components/portfolio/PortfolioFilters.tsx",
        "Props: filters (string[]), active, onChange",
        "Features: All filter + dynamic year/category buttons",
        "Accessibility: aria-pressed for active state",
        "Uses pf-filters and pf-filter-btn CSS classes"
      ]
    },
    "useManifest": {
      "name": "useManifest",
      "entityType": "Hook",
      "observations": [
        "Custom hook for fetching JSON portfolio manifests",
        "Located in src/components/portfolio/useManifest.ts",
        "Features: 30min client-side caching, error handling",
        "Returns: { data, status, error }",
        "Exports imageUrl builders for all portfolio types",
        "Supports: concert, events, journalism, portrait, nature, featured manifests"
      ]
    },
    "imageUrl": {
      "name": "imageUrl",
      "entityType": "Utility",
      "observations": [
        "Object with URL builder functions for portfolio images",
        "Located in src/components/portfolio/useManifest.ts",
        "Methods: journalism(), concert(), events(), portrait(), nature(), featured()",
        "Uses jsDelivr CDN in production: cdn.jsdelivr.net/gh/McCal-Codes/McCals-Website@main",
        "Uses local paths in development (IS_DEV check)",
        "Base path: src/images/Portfolios"
      ]
    },
    "usePageMeta": {
      "name": "usePageMeta",
      "entityType": "Hook",
      "observations": [
        "Hook for setting page SEO meta tags and JSON-LD",
        "Located in src/hooks/usePageMeta.ts",
        "Supports: title, description, canonical, OpenGraph, Twitter cards, JSON-LD",
        "Dynamically creates/updates meta tags in document head",
        "Cleanup: restores previous title on unmount, removes JSON-LD script"
      ]
    }
