#!/bin/sh
# commit-msg hook.
#
# Two jobs:
#   1. Reject AI attribution before it enters history at all.
#   2. Append the author note, as it always has.
#
# This is fast local feedback, not the guarantee. Hooks are opt-in and
# `--no-verify` skips them, so .github/workflows/no-ai-attribution.yml is what
# actually enforces this. Keep the two in step.

MSG_FILE="$1"
if [ -z "$MSG_FILE" ]; then
  echo "No commit message file provided" >&2
  exit 0
fi

if command -v node >/dev/null 2>&1; then
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
  CHECKER="$REPO_ROOT/scripts/ci/check-no-ai-attribution.js"
  if [ -f "$CHECKER" ]; then
    if ! node "$CHECKER" --text "$(cat "$MSG_FILE")"; then
      echo "" >&2
      echo "Commit rejected by .githooks/commit-msg." >&2
      exit 1
    fi
  fi
fi

NOTE="\n\nAuthor: mccal"

# Check if note already present
grep -q "Author: mccal" "$MSG_FILE" && exit 0

# Append the note to the commit message
printf "%s" "$NOTE" >> "$MSG_FILE"

exit 0
